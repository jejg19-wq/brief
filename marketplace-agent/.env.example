# ── Claude ─────────────────────────────────────────────────────────────
# Clave de https://platform.claude.com (o deja vacío si usas `ant auth login`)
ANTHROPIC_API_KEY=
# Modelo. Por defecto claude-opus-5. Alternativas: claude-sonnet-5 (más barato), claude-fable-5-1
CLAUDE_MODEL=claude-opus-5
# Profundidad de razonamiento: low | medium | high. medium sobra para un chat de ventas.
CLAUDE_EFFORT=medium

# ── Meta / Messenger Platform ──────────────────────────────────────────
# Token de acceso de la Página (Meta for Developers → tu app → Messenger → Generar token)
PAGE_ACCESS_TOKEN=
# "Clave secreta de la app" (Configuración de la app → Información básica). Firma cada webhook.
APP_SECRET=
# ID de la app (opcional; ayuda a distinguir tus propios ecos)
APP_ID=
# Cualquier texto que inventes. Se pega igual en la configuración del webhook en Meta.
VERIFY_TOKEN=
# Versión de la Graph API
GRAPH_VERSION=v23.0

# ── Comportamiento ─────────────────────────────────────────────────────
# borrador: el agente redacta y tú apruebas desde el panel (recomendado los primeros días)
# auto: el agente responde solo
MODO=borrador
# Contraseña del panel web. Sin ella el panel queda desactivado.
DASHBOARD_PASSWORD=
PORT=3000
# Carpeta donde se guarda data/estado.json (en la nube, apunta a un disco persistente)
DATA_DIR=./data
# Espera (ms) tras el último mensaje del comprador antes de responder, para agrupar mensajes seguidos
DEBOUNCE_MS=4000
# Minutos que el bot calla en un hilo después de que respondas a mano o de que derive
PAUSA_TRAS_HUMANO_MIN=120
PAUSA_TRAS_DERIVAR_MIN=120
# Tope de respuestas automáticas por comprador y hora
MAX_RESPUESTAS_POR_HORA=20
# Mensajes de historial que se envían al modelo
HISTORIAL_MAX=30
